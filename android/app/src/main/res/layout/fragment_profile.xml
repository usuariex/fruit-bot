<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F2"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Avatar con icono de lápiz estilo Discord -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/circle_background"
                android:scaleType="centerCrop"
                android:padding="6dp"
                android:elevation="6dp"
                android:clipToOutline="true"
                android:outlineProvider="background" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnChangePhoto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:contentDescription="Cambiar foto"
                android:visibility="gone"
                app:srcCompat="@android:drawable/ic_menu_edit"
                app:tint="#FFFFFF"
                app:backgroundTint="#FF4F88"
                app:borderWidth="0dp" />
        </FrameLayout>

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invitado"
            android:textColor="#C2185B"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="22dp" />

        <!-- Iniciar sesión (fresa intenso) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"
            app:cornerRadius="40dp"
            app:backgroundTint="#FF4F88" />

        <!-- Editar nombre -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar nombre"
            android:textColor="#000000"
            android:visibility="gone"
            android:layout_marginBottom="12dp"
            app:cornerRadius="40dp"
            app:backgroundTint="#FF80A9" />

        <!-- Campo nuevo nombre -->
        <EditText
            android:id="@+id/etNewUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nuevo nombre"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#C2185B"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            app:cornerRadius="40dp"
            app:backgroundTint="#FF4F88" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:textColor="#000000"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:cornerRadius="40dp"
        app:strokeColor="#8B4513"
        app:strokeWidth="4dp"
        app:backgroundTint="#A7E673"
        app:icon="@android:drawable/ic_menu_close_clear_cancel"
        app:iconTint="#000000"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />


    </LinearLayout>

</ScrollView>
