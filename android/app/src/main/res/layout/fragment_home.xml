<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/tvTitleHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explora por Región"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#2E3E5C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitleHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona un departamento para ver sus frutas"
        android:textSize="14sp"
        android:textColor="#8F9BB3"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitleHome"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Lista de Departamentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDepartments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleHome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
