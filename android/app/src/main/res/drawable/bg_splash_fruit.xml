<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Capa 1: El gradiente base (Tonos Naranja/Papaya/Rojo) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF9966"
                android:centerColor="#FF5E62"
                android:endColor="#DD2476"
                android:angle="315"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Capa 2: Círculo decorativo esquina superior derecha (Brillo) -->
    <item android:top="-100dp" android:right="-80dp">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF"/>
            <size android:width="300dp" android:height="300dp"/>
        </shape>
    </item>

    <!-- Capa 3: Círculo decorativo esquina inferior izquierda -->
    <item android:bottom="-120dp" android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="#10000000"/> <!-- Sombra sutil -->
            <size android:width="350dp" android:height="350dp"/>
        </shape>
    </item>

</layer-list>
